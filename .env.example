# ==============================================================================
# ISRO LunarFusion Co-Registration Suite — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required for your environment.

# ── Backend Service Configuration ─────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000

# ── Concurrency & Execution Limits ────────────────────────────────────────────
MAX_IMAGE_DIM=2048
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=900
JOB_RETENTION_HOURS=24
SCRATCH_ROOT=outputs/backend_jobs

# ── Security & Authentication (RBAC / JWT) ────────────────────────────────────
# Set AUTH_ENABLED=true in production to enforce Bearer token verification
AUTH_ENABLED=false
JWT_SECRET_KEY=isro-chandrayaan-lunar-secret-key-replace-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins or "*" for development
CORS_ORIGINS=*

# ── Frontend Mission Control Defaults ─────────────────────────────────────────
ISRO_DEFAULT_CALLSIGN=MAHIM-SCIENTIST-SAC
ISRO_DEFAULT_CLEARANCE="Level 4 — Flight Director & Sub-Pixel Lead"
MAX_PROCESSING_DIM=2048

# ── High-Resolution Raster Safety Limits ──────────────────────────────────────
# Allocate large pixel buffer for ultra-high-resolution PDS4/OHRC lunar rasters
OPENCV_IO_MAX_IMAGE_PIXELS=1099511627776
